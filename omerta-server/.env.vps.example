# Copy to .env on the VPS and edit values before first start.
# Keep this file private. Do not commit real secrets.

# Public endpoints. You can use http://YOUR_VPS_IP first, then switch to https://api.yourdomain.com.
PUBLIC_API_URL=http://YOUR_VPS_IP
PUBLIC_WS_URL=ws://YOUR_VPS_IP/ws
DASHBOARD_ORIGIN=http://YOUR_VPS_IP
VITE_API_URL=http://YOUR_VPS_IP

# Database
POSTGRES_DB=omerta
POSTGRES_USER=omerta
POSTGRES_PASSWORD=CHANGE_STRONG_DB_PASSWORD
DATABASE_URL=postgres://omerta:CHANGE_STRONG_DB_PASSWORD@omerta-postgres:5432/omerta

# Server secrets. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_64_CHAR_RANDOM_SECRET
COOKIE_SECRET=CHANGE_64_CHAR_RANDOM_SECRET

# First creator account for the infrastructure/control plane.
CREATOR_EMAIL=creator@omerta.local
CREATOR_PASSWORD=CHANGE_LONG_CREATOR_PASSWORD

# Relay retention: ciphertext queue only, no permanent message/note history.
RELAY_PAYLOAD_DEFAULT_TTL_MINUTES=1440
RELAY_PAYLOAD_MAX_TTL_MINUTES=4320
RELAY_PAYLOAD_MAX_BYTES=32768

# Invite hardening
INVITE_DEFAULT_TTL_HOURS=72
INVITE_MAX_ATTEMPTS=8
INVITE_LOCK_MINUTES=30

# Optional: set to 1 after adding TLS certs and HTTPS nginx config.
OMERTA_ENABLE_HTTPS=0
